{
  "id": "receipt-round-trip",
  "tier": "logic",
  "setup": {
    "reset": true,
    "repro": "{{target.demoRepros.real}}"
  },
  "actions": [
    { "op": "executeTool", "name": "write_repro", "input": { "code": "{{repro}}" }, "saveAs": "draft" },
    { "op": "executeTool", "name": "run_repro", "saveAs": "greenRun" },
    { "op": "executeTool", "name": "submit_report", "input": {}, "saveAs": "staged" },
    { "op": "click", "selector": "#sign-panel button", "saveAs": "signed" },
    { "op": "readSignedArtifact", "saveAs": "artifact" },
    { "op": "prepareReceiptShare", "artifact": "artifact", "saveAs": "review" },
    { "op": "inspectInboxReceipt", "saveAs": "receiptPage" },
    { "op": "encodeReceipt", "artifact": "artifact", "review": "review", "saveAs": "receipt" },
    { "op": "decodeReceipt", "receipt": "receipt", "saveAs": "decoded" }
  ],
  "expect": {
    "reason": "STABLE_LOCAL_DIFFERENTIAL",
    "stagedStatus": "staged_awaiting_local_approval",
    "artifactHashMatchesDraft": true,
    "publicProjectionRoundTrip": true,
    "publicProjectionHasLogs": false,
    "receiptIdentityMatchesProjection": true,
    "reproHashOk": true,
    "verificationLabel": "Repro hash self-consistent ✓"
  }
}
